{
	"name": "soderlind/ps-last-updated",
	"description": "Adds a sortable Last Updated column to public post type admin lists.",
	"type": "wordpress-plugin",
	"keywords": [
		"wordpress",
		"wordpress-plugin",
		"admin",
		"admin-columns",
		"last-updated"
	],
	"homepage": "https://github.com/soderlind/ps-last-updated",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Per Soderlind",
			"homepage": "https://github.com/soderlind"
		}
	],
	"support": {
		"issues": "https://github.com/soderlind/ps-last-updated/issues",
		"source": "https://github.com/soderlind/ps-last-updated"
	},
	"require": {
		"php": ">=7.4",
		"composer/installers": "^1.0 || ^2.0"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"phpunit/phpunit": "^10.5 || ^11.5"
	},
	"autoload-dev": {
		"psr-4": {
			"PS\\LastUpdated\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit"
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"composer/installers": true
		}
	}
}
